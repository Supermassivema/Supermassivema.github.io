---
# Custom sitemap (replaces jekyll-sitemap) so we can add <image:image> for artworks.
# All <loc> use site.url (https://www.artspacebyron.com.au) + Jekyll pretty permalinks (trailing slash).
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{%- for page in site.html_pages -%}
{%- unless page.sitemap == false or page.name == "404.html" %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
  </url>
{%- endunless -%}
{%- endfor %}
{%- for doc in site.artists %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>
{%- if doc.featured_image %}
    <image:image>
      <image:loc>{{ doc.featured_image | absolute_url | uri_escape }}</image:loc>
    </image:image>
{%- endif %}
  </url>
{%- endfor %}
{%- for doc in site.exhibitions %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>
{%- if doc.featured_image %}
    <image:image>
      <image:loc>{{ doc.featured_image | absolute_url | uri_escape }}</image:loc>
    </image:image>
{%- endif %}
  </url>
{%- endfor %}
{%- for doc in site.artworks %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>
{%- if doc.image %}
    <image:image>
      <image:loc>{{ doc.image | absolute_url | uri_escape }}</image:loc>
    </image:image>
{%- endif %}
  </url>
{%- endfor %}
</urlset>
